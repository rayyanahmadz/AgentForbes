# Copy to .env and fill in your Supabase project's URL/anon key — the same
# project the web app (apps/web) already uses. Expo only exposes env vars
# prefixed EXPO_PUBLIC_ to the client bundle; anything else stays server-only
# (irrelevant here since there's no server, but that's the naming rule).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
